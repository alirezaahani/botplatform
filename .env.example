# Copy this file to .env. The database is only reachable inside Docker's network.
# Use letters and numbers in the password, because it is placed in a connection URL.
POSTGRES_USER=botplatform
POSTGRES_PASSWORD=change-me
POSTGRES_DB=botplatform

# The web UI is published on 127.0.0.1 at this port.
WEB_PORT=8000

# A run is killed and marked `timeout` after this many seconds.
RUN_TIME_LIMIT_SECONDS=180

# The ARCaptcha demo bot logs in with these. The demo site itself shows them on its login page
# ("username:demo,password:demo"), so they are the public demo site's credentials, not secrets.
ARCAPTCHA_USERNAME=demo
ARCAPTCHA_PASSWORD=demo
